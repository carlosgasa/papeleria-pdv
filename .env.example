# Configuración pública de Firebase (Project settings > General > Your apps > SDK setup and configuration)
# Es seguro exponer estos valores en el cliente siempre que las reglas de seguridad de Firestore
# (firestore.rules) estén configuradas correctamente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
